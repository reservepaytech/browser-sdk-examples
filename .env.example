# Copy to .env and fill in from the merchant dashboard, under Developer settings.
# .env is git-ignored. Never commit a real API key.

# Public values: the browser receives these through /config.js.
RESERVEPAY_MERCHANT_ID=
RESERVEPAY_INSTALLATION_ID=

# Secret: only the server reads this. Never send it to the browser.
RESERVEPAY_API_KEY=

# Webhook endpoint verification key, from the same Developer settings page.
# HMAC_SHA256 endpoints give you a secret key; ED25519 endpoints give you a public key.
RESERVEPAY_WEBHOOK_SIGNATURE_TYPE=HMAC_SHA256
RESERVEPAY_WEBHOOK_KEY=

# Where this server is reachable. Used to build return URLs.
BASE_URL=http://demo.localhost:6767
PORT=6767

# Optional overrides. Defaults point at production Reservepay.
# RESERVEPAY_API_URL=https://api.reservepay.com
# RESERVEPAY_SDK_URL=https://sdk.reservepay.com/js/v1/reservepay.js
